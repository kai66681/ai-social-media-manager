# 敏感隐私配置文件（包含您的智谱大模型 API KEY，绝对不能公开）
.env

# 本地 SQLite 运营历史数据库（包含您的文章管理历史）
social_media.db

# 小红书登录憑證与敏感 Cookie（包含您的真实账号登录 Session，绝对不能泄露）
app/static/xhs_cookies.json
app/static/generated/xhs_login_status.json
app/static/generated/last_image.json

# 本地生图大模型在开发中生成的各种配图和截图
app/static/generated/*.png
app/static/generated/*.jpg
app/static/generated/*.jpeg

# Python 运行缓存与虚拟环境
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
env/
venv/
.venv/

# 编辑器与IDE配置
.vscode/
.idea/
.DS_Store
